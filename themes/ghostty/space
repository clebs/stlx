# Theme
title = "Ghostty 👻"
window-decoration = false
window-padding-x = 10
window-padding-y = 10

background-opacity = 0.85
unfocused-split-opacity = 0.98
cursor-invert-fg-bg = true

# Font
font-family = FiraCode Nerd Font Mono

# cursor
cursor-style = block
shell-integration-features = no-cursor

# quick terminal
quick-terminal-position = left
keybind = global:cmd+period=toggle_quick_terminal

# toggle background-opacity
keybind = cmd+u=toggle_background_opacity

# Key bindings
keybind = shift+delete=esc:d
keybind = shift+backspace=esc:^H
keybind = shift+left=esc:b
keybind = shift+right=esc:f
keybind = "ctrl+shift+l=text:printf '\\e[2J\\e[3J\\e[H'\n"

# unset alt+left/right so that tmux pane switch still works
keybind = alt+left=unbind
keybind = alt+right=unbind

# colors: normal first, bright second

background = 0a0f1a
foreground = a8dfff

# cursor
cursor-color = 00ccff
cursor-text = 0a0f1a

# black
palette = 0=0d1b26
palette = 8=123247

# red
palette = 1=0099cc
palette = 9=33ccff

# green
palette = 2=00e0b8
palette = 10=33ffdd

# yellow
palette = 3=33ccff
palette = 11=66ddff

# blue
palette = 4=00aaff
palette = 12=33bbff

# magenta
palette = 5=3399ff
palette = 13=66b2ff

# cyan
palette = 6=66e0ff
palette = 14=99eeff

# white
palette = 7=cceeff
palette = 15=ffffff
