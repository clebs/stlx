# Theme
title = "Ghostty 👻"
window-decoration = false
window-padding-x = 10
window-padding-y = 10

background-opacity = 0.92
unfocused-split-opacity = 0.98

# Font
font-family = FiraCode Nerd Font Mono

# cursor
cursor-style = block
shell-integration-features = no-cursor

# quick terminal
quick-terminal-position = left
keybind = global:cmd+period=toggle_quick_terminal

# toggle background-opacity
keybind = cmd+u=toggle_background_opacity

# colors dim first, bright second

# Primary colors
background = 1a1a1a
foreground = e5d6c6

# Cursor
cursor-color = ff884d
cursor-text = 1a1a1a

# Selection
selection-background = ffbb99
selection-foreground = 1a1a1a

# black
palette = 0=#1a1a1a
palette = 8=#2a2a2a

# red
palette = 1=#d45d4c
palette = 9=#e87461

# green
palette = 2=#9e8f70
palette = 10=#b39c7c

# yellow
palette = 3=#d9a066
palette = 11=#e3b97f

# blue
palette = 4=#6c5b4c
palette = 12=#7f6b5d

# magenta
palette = 5=#b57276
palette = 13=#c6898c

# cyan
palette = 6=#a98274
palette = 14=#ba9486

# white
palette = 7=#d1c0b0
palette = 15=#f2e6d8

# Key bindings
keybind = shift+delete=esc:d
keybind = shift+backspace=esc:^H
keybind = shift+left=esc:b
keybind = shift+right=esc:f
keybind = "ctrl+shift+l=text:printf '\\e[2J\\e[3J\\e[H'\n"

# unset alt+left/right so that tmux pane switch still works
keybind = alt+left=unbind
keybind = alt+right=unbind
